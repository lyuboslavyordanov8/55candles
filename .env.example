# Copy to `.env.local` for development. Never commit a filled-in copy —
# `.gitignore` excludes `.env*`, and `.env.example` is the documented exception.
#
# AUDIT.md N-12.

# ---------------------------------------------------------------------------
# Site (required in production)
# ---------------------------------------------------------------------------

# Canonical origin, no trailing slash. While this is unset the site emits
# `noindex` and robots.txt disallows everything, deliberately, so that
# preview deployments cannot be indexed (AUDIT.md Q-06).
#   e.g. https://55candles.example
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Contact form email (AUDIT.md B-17, B-20)
# ---------------------------------------------------------------------------

# Where contact-form enquiries are delivered. Until BOTH this and the API key
# below are set, /api/contact returns 503 and the form honestly tells the
# customer to phone instead — rather than claiming success and dropping the
# message, which is what it used to do.
CONTACT_EMAIL_TO=

# API key for the chosen transactional email provider. No provider is picked
# yet; `src/lib/mailer.ts` has the one function to implement.
EMAIL_PROVIDER_API_KEY=

# ---------------------------------------------------------------------------
# Payments — Stripe (AUDIT.md Q-20, B-10/B-11)
# ---------------------------------------------------------------------------

# Read by `src/lib/payments.ts`. While EITHER is unset, the card option is
# hidden at checkout and only наложен платеж is offered — a hidden option is
# better than one that fails after the customer has committed to it.
#
# The webhook secret is what makes "paid" server-authoritative. Never mark an
# order paid because the customer landed on the success URL; they can navigate
# there directly.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Couriers (AUDIT.md Q-22, B-13/B-14)
# ---------------------------------------------------------------------------

# Read by `src/lib/couriers/index.ts` for the office and locker nomenclature.
# While unset, the office picker falls back to a free-text field rather than
# showing a list of invented offices.
#
# These come from a signed merchant contract, as do the rate cards in
# `src/lib/shipping.ts` — which are separate, and also still empty.
# ECONT_USERNAME=
# ECONT_PASSWORD=
# SPEEDY_USERNAME=
# SPEEDY_PASSWORD=

# ---------------------------------------------------------------------------
# Database — Neon Postgres, EU Central / Frankfurt (AUDIT.md B-01, Q-34)
# ---------------------------------------------------------------------------

# TWO connection strings, and they are not interchangeable.
#
# DATABASE_URL is the POOLED one — the Neon host containing `-pooler`. All
# application queries use it. Serverless functions open a connection per
# invocation and would exhaust a direct connection limit under real traffic.
#
# DATABASE_URL_UNPOOLED is the DIRECT one, used only by drizzle-kit for
# migrations: DDL and migration advisory locks do not behave predictably
# through a transaction-mode pooler.
#
# They differ by one token, so you can derive either from the other:
#   direct  ...@ep-name-a1b2c3.eu-central-1.aws.neon.tech/neondb?sslmode=require
#   pooled  ...@ep-name-a1b2c3-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
#
# The Neon integration in Vercel sets both automatically — prefer that over
# pasting them by hand.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
